# =====================================================================
# WearMind 环境变量模板
# 用法：复制此文件为 apps/api/.env 后按需填写
#       cp .env.example apps/api/.env
# 注意：.env 已被 .gitignore 排除，真实密钥永远不要提交到仓库
# =====================================================================

# ---------- 应用 ----------
# 可选值：development | staging | production
APP_ENV=development
APP_NAME=WearMind
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# 可选值：text | json
LOG_FORMAT=text
# 允许跨域的前端地址（多个用英文逗号分隔）
CORS_ORIGINS=http://localhost:3000

# ---------- 开发身份（**不是认证**） ----------
# 认证尚未实现。为能在本地调用 /api/v1/items，需要一个"当前用户"，
# 这里用固定开发身份代替：所有请求都以该用户身份执行。
#
# 生效条件（三者必须同时满足）：
#   1. APP_ENV=development
#   2. DEV_USER_ENABLED=true
#   3. DEV_USER_PUBLIC_ID 是合法 UUID
# 任一不满足 → 需要身份的接口返回 401。
#
# 安全约束：
#   - APP_ENV=production 且 DEV_USER_ENABLED=true 时，应用会**拒绝启动**；
#   - 该身份只来自服务端配置，请求体/查询参数/请求头都无法改变它；
#   - 首次使用时会按 public_id 幂等创建该用户（不会重复创建）。
#
# public_id 用 UUID 而非自增 ID：换机器、重建库后同一个配置仍指向同一个逻辑用户。
DEV_USER_ENABLED=true
DEV_USER_PUBLIC_ID=8f3a1c2e-0b7d-4e5f-9a61-2c4d8e7b1f30
DEV_USER_DISPLAY_NAME=本地开发用户

# ---------- 数据库 ----------
# 留空表示"尚未配置"，/health 会如实返回 not_configured。
# 本机已安装 PostgreSQL 17（D:\PostgreSQL\17）。首次初始化用
#   uv run python scripts/db_bootstrap.py --apply
# 该脚本会交互式询问密码（不回显），**不生成、不保存、不打印密码**。
# 请把你设定的密码填入下面的 DATABASE_URL（该文件被 .gitignore 忽略）。
# 格式参考（密码含特殊字符时需 URL 编码）：
#   DATABASE_URL=postgresql+psycopg://wearmind:你的密码@localhost:5432/wearmind
DATABASE_URL=

# ---------- 模型接入 ----------
# 业务默认走哪个 provider：online | ollama
LLM_PROVIDER=online

# 在线模型
ONLINE_MODEL_PROVIDER=
ONLINE_MODEL_NAME=
# 由你自行写入本地 .env，不要粘贴到聊天窗口，不要提交到仓库
ONLINE_MODEL_API_KEY=

# 本地模型（Ollama）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# ---------- 隐私 ----------
# 可选值：local_only | hybrid | cloud_ok
# hybrid 表示：只允许发送裁剪后的单品图与结构化标签，不发送原图/人脸/位置
PRIVACY_MODE=hybrid
